{
  "compilerOptions": {
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "app/*": ["./packages/app/*"],
      "@ui/*": ["./packages/app/ui/*"],
      "@store/*": ["./packages/app/store/*"],
      "@services/*": ["./packages/app/services/*"],
      "@utils/*": ["./packages/app/utils/*"],
      "@hooks/*": ["./packages/app/hooks/*"]
    },
    "baseUrl": ".",
    "jsx": "react-jsx"
  }
}
